#!/bin/bash
# Put the band's crest in the About window, the screensaver and the fastfetch panel when The Seventh Shadow becomes
# the theme. Same steps as 10-branding-family takes for the Gand, Commit, Pagan and Forest families; kept as its own
# hook so this theme installs without editing that one. Other themes are left alone.
set -uo pipefail

[[ ${1:-} == the-seventh-shadow ]] || exit 0

root="$HOME/.config/omarchy/branding"
src="$root/families/seventh-shadow"
[[ -d $src ]] || exit 0

if [[ -f $src/about.txt ]]; then
  install -m 644 "$src/about.txt" "$root/about.txt"
fi

# The screensaver panel ends on a hostname line; centre this machine's name in it.
if [[ -f $src/screensaver.txt ]]; then
  field=$(LC_ALL=C.UTF-8 wc -L <"$src/screensaver.txt")
  host=$(hostname)
  pad=$(((field - ${#host}) / 2))
  ((pad < 0)) && pad=0
  {
    head -n -1 "$src/screensaver.txt"
    printf '%*s%s\n' "$pad" "" "$host"
  } >"$root/screensaver.txt"
fi

if [[ -f $src/fastfetch.jsonc ]]; then
  mkdir -p "$HOME/.config/fastfetch"
  install -m 644 "$src/fastfetch.jsonc" "$HOME/.config/fastfetch/config.jsonc"
fi

exit 0
